{
  plugins: {
    ros2dds: {
      nodename: "zenoh_bridge_p2p_obs_1",
      // namespace: "/d1",
      ros_localhost_only: true,
      ros_automatic_discovery_range: "LOCALHOST",
      allow: {
        publishers: [
                      //"/d1/odom",
                      //"/tf",
                      //"/tf_static",
                    ],
        subscribers: [
                      "/d0/odom",
                      "/d2/odom",
                      "/d3/odom",
                      "/d4/odom",
                      //"/tf",
                      //"/tf_static",
                    ],
        service_servers: [],
        service_clients: [],
        action_servers: [],
        action_clients: [],
      },
    },
  },

  mode: "peer",

  connect: {
    endpoints: [
      "udp/192.168.1.10:7447",
      "udp/192.168.1.30:7447",
      "udp/192.168.1.40:7447",
      "udp/192.168.1.50:7447"
    ]
  },

}
